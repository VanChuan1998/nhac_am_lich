{
  "manifest_version": 3,
  "name": "Nhắc Âm Lịch",
  "version": "1.0.9",
  "description": "Nhắc nhở theo ngày âm lịch Việt Nam: giỗ chạp, mùng 1, ngày rằm, đám cưới. Tự tính ngày, thông báo khi tới hạn.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nhắc Âm Lịch",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}